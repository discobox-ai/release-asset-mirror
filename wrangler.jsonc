{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ─── Shared by every deployment ─────────────────────────────────────────
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "observability": { "enabled": true },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Coordinator"],
    },
  ],

  // ─── Default deployment (`npm run deploy`) ──────────────────────────────
  // Configure a single mirror by editing this block. Everything a deployment
  // needs is here: the Worker name, the repository it mirrors, the R2 bucket
  // that caches assets, and the hostnames it answers on.
  "name": "release-asset-mirror",
  "vars": {
    // The one required setting: which repository each URL prefix mirrors, so
    // that /{namespace}/{tag}/{asset} reaches the right releases. Add an entry
    // per repository. Only names listed here are reachable, which is what
    // stops this Worker becoming an open proxy.
    "REPOSITORIES": {
      "example": "OWNER/REPOSITORY",
    },

    // How long a resolved `latest`/`prerelease` tag is trusted globally,
    // and how long each edge location caches the resulting redirect.
    "ALIAS_TTL_SECONDS": "60",
    "EDGE_ALIAS_TTL_SECONDS": "60",

    // Leave empty to stream assets through the Worker. Set to the HTTPS
    // origin of a custom domain attached directly to the R2 bucket to
    // redirect to R2 instead. See "Direct R2 delivery" in the README.
    "R2_PUBLIC_BASE_URL": "",
    "R2_REDIRECT_TTL_SECONDS": "3600",
  },
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "release-asset-mirror",
      "preview_bucket_name": "release-asset-mirror-dev",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "Coordinator",
      },
    ],
  },

  // Serve the mirror from your own hostname. Requires the zone to live in
  // this Cloudflare account; Wrangler creates the DNS record and certificate.
  // Add `"workers_dev": false` alongside it to serve *only* that hostname.
  // "routes": [{ "pattern": "assets.example.com", "custom_domain": true }],

  // ─── Additional deployments (`npm run deploy -- --env NAME`) ────────────
  // One block per extra mirror. Wrangler does not inherit `vars`,
  // `r2_buckets` or `durable_objects` into a named environment, so each one
  // repeats them in full. The `example` block below is a template, not a live
  // deployment: it exists so `npm run check` bundles the named-environment
  // path, and is safe to delete.
  //
  // Deployments we operate live in their own repository and depend on this
  // one; see "Deploying from another repository" in the README.
  "env": {
    "example": {
      "name": "release-asset-mirror-example",
      "workers_dev": false,
      "vars": {
        "REPOSITORIES": {
          "example": "OWNER/REPOSITORY",
        },
        "ALIAS_TTL_SECONDS": "60",
        "EDGE_ALIAS_TTL_SECONDS": "60",
        "R2_PUBLIC_BASE_URL": "",
        "R2_REDIRECT_TTL_SECONDS": "3600",
      },
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "release-asset-mirror-example",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "COORDINATOR",
            "class_name": "Coordinator",
          },
        ],
      },
    },
  },
}
